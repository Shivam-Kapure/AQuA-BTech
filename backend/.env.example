# Copy to .env for local development. Never commit the copied file.
APP_ENV=development
AUTH_SECRET_KEY=replace-with-a-long-random-value
MONGODB_URI=mongodb://localhost:27017
DB_NAME=agentic_testing

# Target access policy. Empty allowlist = any public host may be tested.
# Set a comma-separated list (e.g. app.example.com) to restrict targets.
TARGET_HOST_ALLOWLIST=
# true lets you test localhost/private-network apps (local dev). Use false when deployed.
ALLOW_PRIVATE_TARGETS=true
HTTP_VERIFY_TLS=true

# LLM: Groq (cloud) or LM Studio (local, set LLM_PROVIDER=lmstudio and LMSTUDIO_URL).
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
AGENT_LLM_MODEL=openai/gpt-oss-120b
# Used automatically when LLM_MODEL hits Groq's daily token cap.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Hidden reasoning budget for gpt-oss models (low = fewer tokens and faster runs).
LLM_REASONING_EFFORT=low
# Max simultaneous LLM requests (others queue) to stay within per-minute token limits.
LLM_MAX_CONCURRENCY=2
LMSTUDIO_URL=http://localhost:1234
LLM_READINESS_REQUIRED=false
LLM_READINESS_TIMEOUT_S=2.0

ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
ZAP_TIMEOUT_S=300
PLAYWRIGHT_RUN_TIMEOUT_S=180
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_MAX_BYTES=10485760
