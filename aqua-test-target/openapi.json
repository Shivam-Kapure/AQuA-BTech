{
  "openapi": "3.0.3",
  "info": {
    "title": "Circle Social API",
    "version": "1.0.0",
    "description": "A self-contained social-media demo API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        },
        "security": []
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Register"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User and token"
          },
          "400": {
            "description": "Invalid username, password, name or bio; or unknown field(s) in request body"
          },
          "409": {
            "description": "Username already exists"
          }
        },
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User and token"
          },
          "400": {
            "description": "Username or password missing; or unknown field(s) in request body"
          },
          "401": {
            "description": "Invalid username or password"
          },
          "429": {
            "description": "Too many failed sign-in attempts"
          }
        },
        "security": []
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Sign in to continue"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session ended"
          },
          "401": {
            "description": "Sign in to continue"
          },
          "400": {
            "description": "Unknown field(s) in request body"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoBody"
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "operationId": "listPosts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "community"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed (optionally filtered by q)"
          }
        },
        "security": []
      },
      "post": {
        "operationId": "createPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Content"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New post"
          },
          "400": {
            "description": "Post content must be 1–280 characters; or unknown field(s) in request body"
          },
          "401": {
            "description": "Sign in to continue"
          }
        }
      }
    },
    "/api/posts/{id}/like": {
      "post": {
        "operationId": "toggleLike",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostId"
          }
        ],
        "responses": {
          "200": {
            "description": "Like state"
          },
          "401": {
            "description": "Sign in to continue"
          },
          "404": {
            "description": "Post not found"
          },
          "400": {
            "description": "Unknown field(s) in request body"
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoBody"
              }
            }
          }
        }
      }
    },
    "/api/posts/{id}/comments": {
      "post": {
        "operationId": "createComment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Content"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post with the new comment"
          },
          "400": {
            "description": "Comment content must be 1–280 characters; or unknown field(s) in request body"
          },
          "401": {
            "description": "Sign in to continue"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "operationId": "searchUsers",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching users"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "PostId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "alex"
          },
          "password": {
            "type": "string",
            "example": "choose-a-password"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Register": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,24}$",
            "example": "qa_tester"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "choose-a-password"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "example": "QA Tester"
          },
          "bio": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Content": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "example": "Looking forward to meeting everyone."
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false
      },
      "NoBody": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 0,
        "description": "This operation takes no request body fields."
      }
    }
  }
}
